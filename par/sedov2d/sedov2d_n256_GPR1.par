## =============================
## name the simulation and data files
## =============================
sim_dataFileBaseName = 'data/sedov2d/sedov2d_n256_GPR1/sedov2d_n256_GPR1'

## =============================
## simulation parameters
## =============================
sim_gamma = 1.4
sim_smallPressure = 1.0e-12
sim_smallEnergy = 1.0e-12
sim_smallDensity = 1.0e-12
sim_smallB = 1.0e-12
sim_riemannSolver = 'hllc'
sim_cfl = 0.8
sim_tmax = 0.05
sim_nstepmax = 1000000
sim_forceHydro = .true.

## =============================
## input/output parameters
## =============================
sim_outputFreqTime = 0.0025 # positive real number. Negative or zero if not used
sim_outputFreqStep = 0 # positive integer. Negative or zero if not used
sim_outputHdf5 = .true. 
sim_outputAscii = .false.

## =============================
## grid parameters
## =============================
grid_Nx = 256 # number of cells
grid_Ny = 256 # number of cells
grid_xBeg = -0.5
grid_xEnd =  0.5
grid_yBeg = -0.5
grid_yEnd =  0.5

## =============================
## GP (Guassian process) parameters
## =============================
GP_maxRadius = 1
GP_ellOverDelta = 6.0 # ell/min(dx,dy)


## =============================
## Initial Conditions (ICs) for
## 2D sedov problem
## =============================
IC_type = 'sedov2d'
IC_shockCenter_x = 0.0 # x coordinate of center of circle
IC_shockCenter_y = 0.0 # y coordinate of center of circle

## =============================
## Boundary Conditions (BCs)
## =============================
sim_BC = 'outflow'
